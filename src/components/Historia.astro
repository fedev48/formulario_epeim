---
import Huella from './Huella.astro';
import { historia } from '../data/history';
import { rastroDataUri } from '../lib/huella';

// Pasos tenues entre un hito y el siguiente (mismo verde que los títulos).
const rastro = `background-image:${rastroDataUri('#1a5a36')};background-size:2.5rem 4.5rem;background-repeat:no-repeat space;background-position:center top`;
---

<section id="historia" class="bg-superficie-alt py-20 md:py-28" aria-labelledby="historia-titulo">
  <div class="contenedor grid gap-12 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <h2 id="historia-titulo" class="titulo-seccion text-titulo">Un jardín que fue creciendo con sus familias</h2>
      <p class="mt-5 text-lg text-tinta-suave">
        Empezamos en 1992 con los más chiquitos. Cada nivel nuevo se abrió porque las familias querían que sus hijos
        siguieran con nosotros.
      </p>
    </div>

    <ol>
      {
        historia.map((hito, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-5 md:gap-x-8">
            <div class="flex flex-col items-center">
              <Huella class:list={['w-7 h-auto text-titulo', i % 2 ? 'translate-x-1' : '-translate-x-1']} izquierda={i % 2 === 0} />
              {i < historia.length - 1 && <span class="mt-3 mb-2 w-10 flex-1 opacity-20" style={rastro} aria-hidden="true" />}
            </div>
            <div class:list={['pt-1', i < historia.length - 1 && 'pb-12 md:pb-14']}>
              <p class="font-display text-[clamp(2rem,3.6vw,2.75rem)] font-extrabold tracking-[-0.04em] leading-none text-titulo">
                {hito.marca}
              </p>
              <h3 class="mt-2 text-xl md:text-2xl">{hito.titulo}</h3>
              <p class="mt-2 max-w-xl text-tinta-suave">{hito.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
